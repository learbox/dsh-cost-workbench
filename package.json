{
  "name": "dsh-cost-workbench",
  "version": "1.0.0",
  "type": "module",
  "description": "Right-sidebar cost-estimation workbench for DeepSeek Harness (Windows-friendly fork of dsh-legal-workbench): Obsidian note library, pricing basis, material prices, variation ledger, cost calculator, glossary, meeting recordings with live transcription, global search, and a cost/lite mode switch.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "scripts/**",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost-estimation",
    "quantity-surveying",
    "tendering",
    "obsidian",
    "transcription",
    "workbench"
  ],
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=20"
  }
}
